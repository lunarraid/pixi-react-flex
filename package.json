{
  "name": "@lunarraid/pixi-react-flex",
  "version": "8.0.0-dev.2",
  "description": "Flexbox components for @pixi/react",
  "author": "lunarraid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunarraid/pixi-react-flex.git"
  },
"exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react-spring": {
      "import": "./dist/react-spring/index.es.js",
      "require": "./dist/react-spring/index.js",
      "types": "./dist/react-spring/index.d.ts"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "start": "rollup -c -w",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "yoga-layout": "^3.1.0",
    "@react-spring/animated": "^10.0.3",
    "@react-spring/core": "^10.0.3",
    "@react-spring/types": "^10.0.3"
  },
  "peerDependencies": {
    "@pixi/react": "^8.0.0",
    "pixi.js": "^8.2.6",
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.21.4",
    "@babel/plugin-transform-runtime": "^7.21.4",
    "@babel/preset-env": "^7.21.4",
    "@babel/preset-react": "^7.18.6",
    "@pixi/react": "^8.0.3",
    "@rollup/plugin-babel": "^6.0.3",
    "@rollup/plugin-commonjs": "^24.1.0",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "pixi.js": "^8.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rollup": "^3.29.5",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-typescript2": "^0.36.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist"
  ]
